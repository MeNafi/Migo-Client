# API (FixOra backend)
NEXT_PUBLIC_API_URL=https://migo-tau.vercel.app/

# Frontend origin — used only for client-side links.
# The backend uses its own APP_URL for Stripe success/cancel redirects.
# Ensure backend APP_URL matches this frontend URL (e.g. http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — only needed if you add Stripe Elements later.
# Checkout redirect flow does NOT require this key on the frontend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here


