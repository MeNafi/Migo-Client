# Migo backend (REST base is {NEXT_PUBLIC_API_URL}/api/v1)
NEXT_PUBLIC_API_URL=https://migo-tau.vercel.app
# Frontend origin (used for client-side links / SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Socket.IO server (defaults to NEXT_PUBLIC_API_URL). Vercel cannot host WebSockets,
# so on Vercel the app automatically falls back to polling.
NEXT_PUBLIC_SOCKET_URL=
# Set true only if your backend CORS allows credentials (refresh-token cookie)
NEXT_PUBLIC_WITH_CREDENTIALS=false
# Google Maps JavaScript API key (Places + Maps). Required for interactive location picker.
# Restrict the key to your domain and enable Maps JavaScript API + Places API in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
